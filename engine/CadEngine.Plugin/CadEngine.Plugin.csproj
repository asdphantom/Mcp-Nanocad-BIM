<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Configurations>Debug;Release</Configurations>
    <OutputPath>bin\$(Configuration)</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <UseWindowsForms>true</UseWindowsForms>
    <NanoCadPlatformRoot Condition="$(NanoCadPlatformRoot) == ''">C:\Program Files\Nanosoft\nanoCAD x64 26.0</NanoCadPlatformRoot>
    <NCadBIMSDK Condition="$(NCadBIMSDK) == ''">$(MSBuildThisFileDirectory)..\..\work\ncBIM_SDK_26</NCadBIMSDK>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="hostmgd">
      <HintPath>$(NanoCadPlatformRoot)\bin\hostmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="hostdbmgd">
      <HintPath>$(NanoCadPlatformRoot)\bin\hostdbmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="mapimgd">
      <HintPath>$(NanoCadPlatformRoot)\bin_nPlat\mapimgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="mapinet">
      <HintPath>$(NanoCadPlatformRoot)\bin_nPlat\mapinet.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="imapimgd">
      <HintPath>$(NanoCadPlatformRoot)\bin_nPlat\imapimgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="mapibasetypes">
      <HintPath>$(NanoCadPlatformRoot)\bin_nPlat\mapibasetypes.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="mapibasetypes2">
      <HintPath>$(NanoCadPlatformRoot)\bin_nPlat\mapibasetypes2.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="NrxGateMgd">
      <HintPath>$(NanoCadPlatformRoot)\bin\nrxgatemgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ncBIMSmgd">
      <HintPath>$(NCadBIMSDK)\include-x64\ncBIMSmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="M3D">
      <HintPath>$(NanoCadPlatformRoot)\bin_nPlat\M3D.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
